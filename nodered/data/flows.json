    {
        "id": "d3146d31559b364f",
        "type": "function",
        "z": "a7b49e5e7d2d312e",
        "name": "sim-01 Chart data",
        "func": "const device = msg.payload;\n\nif (device.hostname !== \"sim-01\" || !device.metrics) {\n    return null;\n}\n\nconst timestamp = Date.parse(device.last_seen);\n\nif (!Number.isFinite(timestamp)) {\n    return null;\n}\n\n// State messages can repeat the same measurement.\nif (context.get(\"lastTimestamp\") === timestamp) {\n    return null;\n}\ncontext.set(\"lastTimestamp\", timestamp);\n\nconst fields = [\n    [\"CPU\", \"cpu_percent\"],\n    [\"RAM\", \"ram_percent\"],\n    [\"Disk\", \"disk_percent\"]\n];\n\nconst messages = fields\n    .filter(([, key]) => typeof device.metrics[key] === \"number\")\n    .map(([label, key]) => ({\n        topic: label,\n        payload: device.metrics[key],\n        timestamp\n    }));\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 560,
